{
  "name": "rift-horizon",
  "version": "0.4.0",
  "description": "Rift Horizon desktop",
  "main": "main.js",
  "author": "TheFallenStarGG",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "gg.thefallenstar.rifthorizon",
    "productName": "Rift Horizon",
    "copyright": "Copyright TheFallenStarGG",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../_game_stage",
        "to": "game"
      }
    ],
    "icon": "../favicon.png",
    "win": {
      "icon": "../favicon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "RiftHorizon-${version}-windows-portable.exe"
    },
    "nsis": {
      "artifactName": "RiftHorizon-${version}-windows-setup.exe",
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rift Horizon"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
